# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Env
.venv/
venv/
env/
.env
.env.*

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
logs/*
!logs/.gitkeep
*.log

# Models and checkpoints
models/kronos/*
!models/kronos/README.md
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.bin

# External repos; keep directory placeholder only
external/Kronos/*
!external/Kronos/README.md
!external/Kronos/.gitkeep

# Data / cache
data/cache/*
!data/cache/.gitkeep
data/input/*
!data/input/.gitkeep
data/samples/*.csv
!data/samples/.gitkeep

# Large outputs; keep placeholders and markdown reports
outputs/*.csv
outputs/*.parquet
outputs/*.pkl
outputs/*.feather
outputs/*.jsonl
!outputs/.gitkeep
!outputs/README.md

